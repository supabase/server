{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@supabase/server": ["../src/index.ts"],
      "@supabase/server/middleware/*": ["../src/middleware/*/index.ts"],
